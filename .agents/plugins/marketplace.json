    {
      "name": "postman",
      "description": "Postman API workflow skills with direct MCP access and a short inline startup hook.",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/postmanlabs/postman-plugin.git",
        "path": "./skills"
      },
      "author": {
        "name": "Postman"
      },
      "repository": "https://github.com/postmanlabs/postman-plugin",
      "homepage": "https://learning.postman.com/docs/developer/postman-mcp-server/",
      "license": "Apache-2.0",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools",
      "skills": [
        "./ai-readiness",
        "./api-discovery",
        "./api-documentation",
        "./api-engineer",
        "./api-mocking",
        "./api-monitoring",
        "./api-simulation",
        "./api-testing",
        "./bootstrap",
        "./ci-integration",
        "./collection-schema-v3",
        "./datasets",
        "./flows",
        "./performance-testing",
        "./postman-mcp-server",
        "./variables",
        "./webhook-testing"
      ],
      "mcpServers": {
        "postman": {
          "type": "http",
          "url": "https://mcp.postman.com/mcp"
        }
      },
      "hooks": {
        "hooks": {
          "SessionStart": [
            {
              "matcher": "startup|clear|compact",
              "hooks": [
                {
                  "type": "command",
                  "command": "echo \"For non-trivial API engineering, load postman:api-engineer first; for a specific task, load the matching Postman skill directly. User instructions take precedence.\""
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "ponytail",
      "description": "Minimalist software-development workflows that favor YAGNI and the smallest correct implementation.",
