{
  "description": "Repair configured links when Codex starts inside an existing linked worktree.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/worktree-links.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
